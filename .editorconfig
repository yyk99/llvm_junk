# EditorConfig for mini/EASY compiler project
# https://editorconfig.org

root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# JSON files (CMakePresets.json, package.json, etc.)
[*.json]
indent_style = space
indent_size = 2

# CMake files
[CMakeLists.txt]
indent_style = space
indent_size = 4

[*.cmake]
indent_style = space
indent_size = 4

# C++ source files
[*.{cpp,cc,cxx,h,hpp}]
indent_style = space
indent_size = 4

# Flex and Bison files
[*.{l,y}]
indent_style = space
indent_size = 4

# Makefiles require tabs
[Makefile]
indent_style = tab

[*.mk]
indent_style = tab

# Shell scripts
[*.sh]
indent_style = space
indent_size = 4

# Markdown files
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
