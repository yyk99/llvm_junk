/* nested block if example */
program nested_block_if:
    declare (a, b, c) integer;

    set a := 42;
    set b := 10;
    set c := -100;

    if a > 0 then
       declare (a, b, c) boolean;

       set a := true;
       set b := false;

       output "a=", a;
       output "b=", b;
    else
       declare (a, b, c) real;

       set a := 1.5;
       set b := 2.5;
       set c := 3.99;

       output "a=", a;
       output "b=", b;
       output "c=", c;
    fi;

    output "a=", a;
    output "b=", b;
    output "c=", c;

    return;
end program labeled_block;
