program Eratosthenes:
   declare topnum integer;
   declare a integer;
       select true of
       case ( a < 0 ) : output "A < 0...." ; exit;
       case ( a = 0 ) : return 0;
       case ( a > 0 ) :
            declare (x, ra) real;
            declare epsilon real;
            declare sqrt integer;
            set ra := float(a);
            set epsilon := 0.00000001 * ra;
       end select;
   exit;
end program Eratosthenes;
