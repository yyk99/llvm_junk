/* select nested */
program select_test:
    declare a integer;
    set a := 10;
    select true of
       case ( a < 0 ) : output "a < 0";
       case ( a = 0 ) : output "a = 0";
       otherwise :
          output "a > 0", "a = ", a;
          select a / 2 of
              case (5): output "five";
              otherwise: output "anything else...";
          end select;
    end select;
    exit;
end program select_test;
