/* select nested : nested select w/o OTHERWISE */
program select_test:
    declare a integer;
    set a := 10;
    select true of
    case ( a < 0 ) : output 10;
    case ( a = 0 ) : output 20;
    otherwise :
        output 30;
        select a / 2 of
        case (5): output 40;
        end select;
    end select;
    exit 0;
end program select_test;
