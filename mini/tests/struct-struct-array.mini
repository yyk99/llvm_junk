program StructSample:
    declare p
        structure
           field a is array [10] of integer,
           field s is structure
                        field x is integer,
                        field y is integer
                      end structure,
	   field z is real,
	   field omega is integer
        end structure;

    set p.a[1] := 567;
    set p.z := 0.125;
    set p.omega := -23;
    set p.s.x := 99;
    set p.s.y := 88;

    output p.a[1];
    output p.z;
    output p.omega;
    output p.s.x, p.s.y;
end program StructSample;
